<?xml version="1.0" encoding="utf-8"?>
<!--
  the smallest APK that can hold a surface, and not the frontend this project is aiming at -
  there is no game list, no settings, no picker and no overlay, and the game it runs is hardcoded.
  its content is that the host layer is a library now and that a presented frame has somewhere to
  go.

  four things that used to be here are in app/build.gradle.kts now, because AGP owns them: the
  application id (namespace and applicationId are separate there, and only the second one moves),
  the SDK levels, extractNativeLibs - which is packaging { jniLibs { useLegacyPackaging } } - and
  debuggable, which the debug build type sets and which is a lint error when hardcoded here. the
  label is a string resource so a renamed build can set it without this file being rewritten.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!--
          landscape and locked. the guest decides the presentation size once, at swapchain
          creation, and a rotation would change the surface underneath it - which is a real
          problem for a later milestone and not one worth inventing an answer to here.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
