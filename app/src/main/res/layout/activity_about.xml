<?xml version="1.0" encoding="utf-8"?>
<!--
  the About screen: what this is, what it runs, what it was read against, and what it is under.

  **the frame and nothing else.** the composition is `part_about_body.xml`, which has a `-land`
  variant, because the one thing that changes with the shape of the screen is whether the drawing sits
  above the text or beside it.

  **the scroll view is insurance rather than the design.** both variants are written to hold everything
  at once - upright on a phone and side by side on a landscape handheld - and neither is meant to be
  scrolled. it is here because a screen shorter than either was written for should clip nothing, and it
  costs a view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- the manager screens' toolbar band, without the progress bar: nothing on this screen waits. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back" />

    <!-- **fillViewport, and it is what centres the page.** without it the scroll view measures its
         child at the height that child wants and pins it to the top, which on a screen with room to
         spare leaves the whole composition riding high with a band of nothing under it. with it the
         child is given the viewport's height and can centre inside it, and a screen too short for the
         composition still scrolls exactly as it would have. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        android:scrollbarStyle="outsideOverlay">

        <include
            android:id="@+id/body"
            layout="@layout/part_about_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
