<?xml version="1.0" encoding="utf-8"?>
<!--
  a button on the panel the back button opens over a running game.

  **it is the settings scene's section button with the second line taken out**, and every number it
  shares with that layout is shared deliberately: the same 16dp corner, the same 1dp outline, the
  same surfaceContainer fill, the same 28dp icon at the same 18dp from the text, and the same 6dp
  margin - so the two read as one component in two places rather than as two that resemble each
  other. what differs is what a single line makes different: no summary, no 96dp minimum, and 14dp
  of vertical padding against the section button's 18dp, which is what "one line" wants rather than
  what a two-line block does.

  **the fill sits on colorSurface**, which is the panel behind it and the background every other
  screen in the app draws. that is the pairing the section list has, and it is why the fill may not
  also be colorSurface: a card the colour of its background is not a card.

  **inflated rather than built in code, which the rest of the panel is not.** what made that
  impossible was a window with no Material attributes to resolve; the panel takes its scheme from a
  themed context now, so this can be a layout - and a layout is what makes it exactly the section
  button rather than an imitation maintained by hand.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <!--
          **android:tint and never app:tint, and this holds for anything drawn over a guest.** app:tint
          is read by AppCompatImageView, and the swap from a plain ImageView to that one is done by
          AppCompatActivity's own inflater - which the screens behind the settings scene have and the
          activity a guest renders into does not. So the attribute inflates, does nothing, and the
          vector draws its own white, with no warning of any kind. android:tint is the framework's own
          and is read by the plain view this inflates to.

          **the role is colorOnSurface rather than the section button's colorPrimary**, so the glyph
          and the label beside it are one colour. An accent on a panel this size makes the icon the
          loudest thing on screen over somebody's game, and there is nothing here for it to
          distinguish this row from.
        -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="18dp"
            android:contentDescription="@null"
            android:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
