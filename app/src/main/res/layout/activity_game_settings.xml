<?xml version="1.0" encoding="utf-8"?>
<!--
  one game's settings, upright.

  **the identity is a row above the cards rather than a column beside them**, which is the landscape
  composition turned through ninety degrees for the same reason the game grid changes its column
  count: what is a third of the width on a wide screen is most of the height on a tall one, and a
  cover drawn at that size would push every card below the fold. see layout-land, which is the
  composition this one is derived from and which carries the rest of the reasoning.

  the name is in the toolbar here too, so the two facts beside the artwork are the same two.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back" />

    <!-- the negative margin every card screen in this app takes against the toolbar — see
         activity_settings.xml for what it borrows and why. here it is the identity row that sits
         under the toolbar rather than the list, so it is the row that takes it, and the screen's
         content starts on the line every other screen's does. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <!-- a square, stated as one, for the reason layout-land gives at length: the artwork is
             square and its rounded corner needs the box to be too. fitCenter for the same reason
             there — a crop would take a slice off any dump whose icon is not. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/icon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.SharpEmu.Card" />

        <include
            android:id="@+id/facts"
            layout="@layout/part_game_facts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- the bottom padding is the managers' rather than this scene's own, since this scene now
             carries their button: it is the button's height and margin, so the last card is
             reachable rather than sitting underneath it. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="96dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical" />

        <!-- above the button and below nothing else, so the button keeps its own edges and every
             card passes under it — activity_manager.xml's arrangement, for its reason. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_list_bottom" />

        <!-- **the managers' floating button, in the slot the managers put it in.** what it does here
             is start the game rather than import something, and that is the only difference: a
             person who has learned where the button is on the build, driver and folder screens finds
             this one without looking. -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/launch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="@string/game_settings_launch"
            app:icon="@drawable/ic_play" />

    </FrameLayout>

</LinearLayout>
