<?xml version="1.0" encoding="utf-8"?>
<!--
  the whole of the About screen, stacked: the drawing, what this is, and three labelled facts.

  **a colophon rather than a list.** what the screen carries is five things - what this is, what
  version of it, what emulator it runs, what it was read against, and what it is under - and five
  facts do not want five cards to live in. a label column and a value column is how a book states who
  set it and in what, and it is the shape that holds all of this at once: nothing here scrolls on a
  landscape handheld, nothing expands, and nothing is hidden behind a tap that only reveals text.

  **the drawing is the only decoration and everything else is type.** there is no card anywhere on
  this screen, which is deliberate: a card is a container for a thing among other things, and this
  page is one statement.

  **there is a `-land` variant, and only the axis differs.** stacked, this is taller than a landscape
  handheld has under its toolbar; laid side by side it is the drawing's own height. both carry the
  same ids, so the activity binds one set and never asks which is on, and every string is a resource
  so the words are written once for both.

  **the whole composition is lifted 8dp**, for the reason and by the mechanism activity_about.xml
  records. the attribute is on this root rather than on that file's `include` because an include
  carries only `id`, `visibility` and `layout_*` across to the root it names, and drops everything
  else without a word.

-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="8dp"
    android:translationY="-8dp">

    <!-- **the drawing and the light behind it, and the light is centred on the frame rather than on
         the drawing.** the portrait is transparent above the head and sits on the frame's bottom
         edge, so a glow centred on the image's own box would be high; centred here it lands behind
         the body and spills a little past the feet, which is what makes it read as something being
         sat on. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:clipChildren="false"
        android:layout_marginTop="4dp">

        <!-- **the glow is smaller than the drawing rather than larger**, so the paws and the tuft of
             hair carry past it and it reads as light falling on a body rather than as a disc with a
             character stamped in the middle of it. it is centred on the frame, which puts it behind
             the torso.

             tinted with the accent and drawn at a fifth of it. **the alpha is on the view rather than
             in the drawable** so the ramp keeps its shape: an alpha baked into the gradient's stops
             would flatten the falloff the middle stop exists to bend. -->
        <View
            android:layout_width="252dp"
            android:layout_height="252dp"
            android:layout_gravity="center"
            android:alpha="0.22"
            android:background="@drawable/bg_hero_glow"
            android:backgroundTint="?attr/colorPrimary" />

        <!-- **fitCenter with a fixed height and adjustViewBounds**, so the width follows the drawing's
             own aspect and the frame never letterboxes it. it is the largest thing on the screen and
             is meant to be: the page is a colophon and a colophon's decoration is its one image.

             it answers a tap by moving, and it **carries no ripple** - the one deliberate touch target
             in this app that does not look like one. a borderless ripple on a view this size is a grey
             disc the width of the glow and would make the drawing read as a button about to navigate
             somewhere; the lettering over it and the movement it answers with are the cues instead.

             **`mirco` is the resting face and `mirco_tapped` is the one it pulls when it is pressed.**
             the two are the same drawing at the same size and differ in the eyes and the mouth, so
             the swap costs no layout pass and nothing on the page moves under it. what is named here
             is the resting one, because that is the state the screen opens in and the state it is in
             whenever nobody is pressing it; how long the other one stays on is the activity's.

             **the lift is a translation rather than a margin, and the frame lets it out.** the frame
             is exactly as tall as the drawing, so a margin that moved it would have to change the
             frame's height too, and that height is what sets the block's; the whole page would shift
             by half of whatever was asked for. a translation moves what is drawn and nothing that is
             measured, so the lift is exactly the number written on it. the frame stops clipping its
             children because the drawing now reaches above its top edge. -->
        <ImageView
            android:id="@+id/mirco"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="bottom|center_horizontal"
            android:adjustViewBounds="true"
            android:translationY="-12dp"
            android:contentDescription="@string/about_by"
            android:scaleType="fitCenter"
            android:src="@drawable/mirco" />

        <!-- **the lettering that invites the press, laid over the drawing and registered to it by
             construction.** it is drawn on the same canvas as the two faces and encodes to the same
             size, so an ImageView carrying the drawing's own height, `adjustViewBounds` and
             `fitCenter` resolves to the drawing's own rect and the lettering lands where it was
             drawn. no offset is written anywhere here and there is nothing to keep in step: change
             the height or redraw the artwork and both move together, because both are solving the
             same equation from the same two numbers.

             **it is tinted at runtime rather than coloured in the file**, because no one colour suits
             every scheme - the artwork is black and the surface under it is whatever the scheme says.
             the tint is the accent, which is what the glow behind the drawing already takes, so the
             invitation and the light it sits in are the same colour. **only this file's alpha
             survives the tint**, `SRC_IN` replacing every other channel, which is why a lossy encode
             of it loses nothing that is drawn.

             **it is held under full strength so it reads as a note on the drawing rather than as a
             label competing with it.** nothing animates this, so the attribute is the whole of the
             setting and there is no second place to change.

             **it moves for nothing the drawing does, deliberately - not the rock, and not the
             entrance.** the rock is the character reacting to being pressed, and the lettering is
             not part of the character: a label that swings with the thing it labels reads as one
             picture wobbling rather than as somebody moving. the entrance is the same argument a
             beat earlier - the invitation is on the page from the first frame, and what is shown is
             the character settling in under it rather than a block of picture sliding up as one.

             **it is not clickable, so the press reaches the drawing underneath.** a child that does
             not take a touch is passed over and the next one down is offered it, and these two boxes
             are the same box, so the drawing is what answers wherever the finger lands. it is out of
             the accessibility tree for the matching reason: what a screen reader is given here is the
             drawing and its description rather than a second reading of a cue it cannot see. -->
        <ImageView
            android:id="@+id/tap_me"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="bottom|center_horizontal"
            android:adjustViewBounds="true"
            android:alpha="0.82"
            android:translationY="-12dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/tap_me"
            android:tint="?attr/colorPrimary" />

    </FrameLayout>

    <!-- the project's own name, which is lower case because that is how it is written. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:text="@string/about_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <!-- the version and the commit this APK was built from. a tap copies it, which is the answer to
         wanting it spelled exactly in a bug report. it is drawn quietly because it is the one thing
         here nobody comes looking for until something has already gone wrong.

         **it is set in the app's own face, like every other version label in the app.** a fixed-width
         one was here first, on the argument that a hand-copied identifier wants unambiguous glyphs -
         but a short git hash is lower-case hex, which contains no `l` to confuse with a `1` and no `O`
         to confuse with a `0`, and the build manager has always shown this same pair of values
         proportionally without trouble. what a fixed-width face still buys is help tracking position
         in a long string, and that did not turn out to be worth a second typeface. -->
    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <include
        android:id="@+id/facts"
        layout="@layout/part_about_facts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="24dp" />

</LinearLayout>
