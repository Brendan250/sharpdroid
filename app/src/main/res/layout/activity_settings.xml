<?xml version="1.0" encoding="utf-8"?>
<!--
  the global settings scene: the section buttons, and About in the corner.

  the toolbar carries a back arrow rather than relying on the system one, because this screen is
  entered from the game list's cog and leaving it is the common action.

  **About is a toolbar button and not a seventh card, because it is not a setting.** nothing behind it
  changes what a launch does, so a card in a grid of things that do is a card read past - and the grid
  is one card too tall to fit the scene in a screenful while it is there. the price is that the card's
  line saying what is behind it becomes a content description and a tooltip; that is the whole cost of
  this and it is not recovered anywhere.

  **the horizontal padding is what holds the cards off the screen edge, and outsideOverlay is what
  keeps the scrollbar out of it.** a scrollbar respects its view's padding by default, so padding the
  list alone leaves the track floating a finger's width in from the edge - which is precisely what a
  scrollbar should never look like. outsideOverlay draws it at the view's own edge instead.

  **the top padding is smaller than the horizontal, and the card's own margin is why.** each card
  carries 6dp on every side, so the gap above the first row is that plus this padding while the gap
  between two rows is the two margins meeting - 4dp here draws 10dp under the toolbar against the
  12dp between rows, a little under the list's own rhythm. matching the horizontal 10dp instead puts
  the first row 16dp down, which reads as the list starting late rather than as a margin.

  **the negative top margin is against the toolbar rather than against the list.** the toolbar is
  64dp with its title centred in it, so 23dp of it is empty below the baseline - which is most of the
  distance from the title to the first card, and none of it is something the list's own padding can
  reach. 6dp back is the list borrowing a little of that empty strip, and the driver manager takes
  the same 6dp. the toolbar is drawn first, so
  the list draws over the strip it borrows, and that is why this is a few dp and not a few more: the
  title's baseline is far enough above that scrolled cards pass under empty toolbar and never under
  text.

  **the frame around the list exists to hold the fade it ends in**, and for nothing else. the fade is
  drawn rather than asked of the framework because a view's own fading edge is painted at its bounds
  less its bottom padding, which would put it well up a list that pads itself at all.

  **what is tuned is this view's own padding and margin, never the card's**: a card's margin is half
  the gap between every pair of rows, so moving it moves the whole list to change one edge. the
  driver manager is the same grid with the same numbers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_title">

        <!-- **the same button the game list's cog is, in the same spot**: 48dp of touch target around
             a 24dp glyph, the toolbar's own item background, and an end margin measured to the glyph
             rather than to the box, the icon's edge sitting 12dp inside it. one press separates the
             two, so a corner that moved between them would read as two corners.

             **an end gravity rather than the game list's row of views, and the title is why.** a
             toolbar measures its custom children before its title and gives the title what is left,
             so a `match_parent` child here would starve `app:title` to nothing - that file can afford
             the row because it draws its own title inside it. the two therefore reach the same place
             by different paths, which is why the bounds are read off the device rather than assumed
             equal from one shared margin.

             **a menu item cannot do this.** it sits against the toolbar's end whatever the padding or
             the content inset says, landing in the same place with 6dp of end padding as with none,
             and this button has a specific place to land.

             **the tooltip is the half of the section card that survives.** a card carries a line
             saying what is behind it and a glyph carries a name; long-pressing is where that name is,
             and it is the same string the content description reads out. -->
        <ImageButton
            android:id="@+id/about"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/about"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_about"
            android:tint="?attr/colorOnSurface"
            android:tooltipText="@string/about" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- **the margin is the frame's rather than the list's**, so the list keeps the frame's own
         bounds and no row can be cut by them. a frame that began at the toolbar's edge with the list
         pulled above it would clip the first row's corners instead of moving it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_list_bottom" />

    </FrameLayout>

</LinearLayout>
