<?xml version="1.0" encoding="utf-8"?>
<!--
  a section button: an icon, a title and one line saying what is behind it. Eden's settings menu is
  the shape, down to the icon sitting to the left of both lines rather than above the title.

  the cell is one column or two depending on the orientation - see values/integers.xml.

  **the fill is colorSurfaceContainer and not colorSurfaceVariant, and that is a measurement.** in a
  dynamic (Material You) scheme those two roles and colorOutlineVariant are generated at tones that
  collide: the card was drawn at #50443D with a stroke of #50443D, so the outline existed and could
  not be seen. surfaceContainer is the role meant for a raised block and sits a little above the
  background, which leaves the outline a tone of its own. the hand-written schemes name
  surfaceContainer explicitly so their fills do not move.

  **the card's height is wrap_content and must stay so.** match_parent in a grid cell means the
  height of the whole RecyclerView, not of the row: each card grew to a screenful and two of them
  filled the scene. a minimum height is what keeps a short card from looking cramped instead.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="96dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="18dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="18dp"
            android:contentDescription="@null"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
