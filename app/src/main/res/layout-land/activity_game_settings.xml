<?xml version="1.0" encoding="utf-8"?>
<!--
  one game's settings, on a screen that is wider than it is tall.

  **the game on the left third and its settings on the right two thirds**, which is what the width
  buys: the artwork is drawn at a size worth drawing and the cards keep the column they have on the
  app's own settings scene. the weights are 1 and 2 rather than a dp measurement, so the split holds
  on a panel of any width.

  **the name is in the toolbar rather than under the artwork.** it is the title of the screen, and a
  toolbar is where this app puts a screen's title; under the artwork it competed with the facts below
  it for which line was the heading, and both lost.

  the two lines that remain are facts about the dump and they are left aligned, because a column of
  values centred on itself has no edge to read down. the block hangs from the same line the first
  card starts on, so the two sides of the screen begin together.

  the list's padding, the scrollbar style and the fade are activity_settings.xml's, and the reasoning
  for each is written there.
-->
<!-- **the frame exists so the floating button can hang off the screen rather than off the row.**
     everything below it is one column of content, and the row that holds it carries a negative top
     margin, so a button placed inside that row sits that margin higher than the same button on
     every manager screen, which measures as a real difference and reads as a wobble when you move
     between them. a sibling of the whole column is positioned against the panel, which is what a
     floating button is positioned against everywhere else in this app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back" />

    <!-- **the negative margin is against the toolbar, and it is the one every card screen in this
         app takes**. see activity_settings.xml, which explains it: a toolbar is 64dp with its title
         centred in it, so a strip below the baseline is empty, and the content below borrows a
         little of it rather than starting under the whole thing. without it this screen's cards sat
         6dp lower than the same cards everywhere else.

         **it is on the row rather than on either column**, so the artwork and the first card move
         together and stay on the one line they were just put on. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-6dp"
        android:orientation="horizontal">

        <!-- a constraint layout for one reason: **the artwork is square and only a ratio can say
             so.** a linear layout can give a view all of the width or all of the leftover height,
             and neither of those is a square, which is what the artwork is, and what its rounded
             corner needs it to be drawn as. -->
        <!-- **the artwork is inset by half again what the cards are, and both of its sides are the
             same 24dp**: its left against the screen, and its right against the first card.

             **matching the cards' own inset is not the same as looking like it.** a card is a filled
             surface with a rounded edge and its own quiet inside it, so the 16dp between the last
             card and the panel is read as the last of a series of margins; the artwork is ink to all
             four corners, and the same 16dp beside it reads as the picture having been pushed
             against the edge. equal numbers, unequal gaps. so this column takes half again the
             figure and the cards keep theirs, which is what makes the two sides of the screen look
             evenly placed rather than measure evenly.

             **half again rather than twice**, which the column is wide enough to carry and the
             picture is not: this column is a third of the panel, so at double the inset the artwork
             loses an eighth of its side and starts reading as a thumbnail with a lot of air around
             it rather than as the thing the screen is arranged around.

             **the two sides are different numbers for the same gap**, because only one of them is
             paid for entirely here. on the left nothing else contributes and the whole 24dp is
             spelled out. on the right the list beside this column already contributes 16dp, being its
             own 10dp of scroll padding plus the 6dp margin every card in this app carries, so what
             is left to add is the 8dp between them.

             it is only right while those two numbers are what they are, and neither belongs to this
             file: they are the list in activity_settings.xml and the card itself. XML cannot hold
             the subtraction, which is why it is written out here.

             **the square shrinks by exactly what is added here**, its width driving its height
             through the 1:1 ratio below, and that is the price rather than a side effect: this
             column is a third of the panel and every dp of inset comes out of the picture. -->
        <!-- **the column scrolls, because a square as wide as a third of the screen plus a path that
             wraps is taller than a short panel.** the cards beside it have scrolled from the day
             there were three of them, and this side had been getting away with it. `fillViewport` is
             what keeps the block laid out against the full height when it does fit, rather than
             collapsing to its own. -->
        <!-- the frame is here so the column can end in a fade, which a scroll view cannot hold
             itself: it takes one child, and that child is the thing being scrolled. so the fade is a
             sibling laid over the bottom of the column, which is the arrangement the cards' list
             beside it already uses. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

        <!-- the bottom padding is exactly as deep as the fade below this column, so a column
             scrolled to its end has the fade sitting on padding and dimming nothing. the two are one
             number and have to move together; XML cannot say that, so it is said here. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="40dp">

            <!-- **as wide as the column allows, and exactly as tall.** `H,1:1` computes the height
                 from the width, so the box is a square whatever the panel is, and the artwork is
                 drawn inside it untouched: a square image in a square box fills it exactly, which is
                 what puts the rounded corner on the picture rather than on empty space beside it.

                 **fitCenter rather than a crop**, the box being the right shape. a crop would
                 also fill it, and would quietly take a slice off any dump whose icon is not square,
                 paying with somebody's artwork for a corner that is already correct.

                 the corner is the one every card in this app is cut with. see the shape style,
                 which says why it is the card's radius and not a tile's.

                 **it starts level with the first card, and the column's own top padding is what
                 makes that exact rather than close.** a card is inset from the top of its list by
                 that list's 4dp of padding and its own 6dp margin, so 10dp here starts the artwork
                 on the same line: the same trick as the horizontal gap above, and the same warning
                 applies: neither of those two numbers belongs to this file.

                 **the block hangs from that line rather than being centred in the column**, which it
                 was, and which put its top a couple of pixels above the card's by coincidence. a
                 centred block lands where its own height leaves it, and agreeing with a fixed inset
                 is not something it can be relied on to keep doing. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/titleId"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SharpDroid.Card" />

            <include
                android:id="@+id/facts"
                layout="@layout/part_game_facts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icon" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- the same fade the cards' list ends in, and deliberately a taller one.

             a fade is only as visible as the difference it makes, and here it makes almost none: the
             gradient ends in the surface colour, and this column's background already is that colour,
             so it changes nothing behind the text and takes only the glyphs. the cards beside it
             sit on a lighter fill, so the same gradient washes a whole card's width from that fill
             down to the surface and their text dissolves along with everything around it. matching
             that by eye means giving this column the one thing it can be given, which is distance:
             text with nothing behind it needs more of it to go softly.

             it covers the column's own bottom padding, which is set to the same figure, so a column
             scrolled to its end has nothing dimmed. that is what makes it safe to leave up rather
             than fading it in only when there is more to see, and it is the trade the cards' list
             makes with its own deeper padding. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_list_bottom" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <!-- the bottom padding is the managers' rather than this scene's own, since this scene
                 now carries their button: it is the button's height and margin, so the last card is
                 reachable rather than sitting underneath it. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sections"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="96dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

            <!-- the fade the cards end in, at every manager's own height. it is a fade per column
                 rather than one across the panel: the two columns are the same surface, so nothing
                 seams where they meet, and each ends in the depth its own content needs. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_list_bottom" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>

    <!-- **the managers' floating button, in the slot the managers put it in**. see the portrait
         layout, which says why it is theirs rather than this scene's own.

         **it is a sibling of the content rather than a child of the cards' column**, which is the
         frame above's whole reason: only from here is it 20dp off the panel's own bottom edge, which
         is where every other floating button in this app sits. the cards' column reaches the same
         bottom edge but starts 6dp higher, and a button inside it inherits that. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/launch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/game_settings_launch"
        app:icon="@drawable/ic_play" />

</FrameLayout>
