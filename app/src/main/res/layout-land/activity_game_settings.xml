<?xml version="1.0" encoding="utf-8"?>
<!--
  one game's settings, on a screen that is wider than it is tall.

  **the game on the left third and its settings on the right two thirds**, which is what the width
  buys: the artwork is drawn at a size worth drawing and the cards keep the column they have on the
  app's own settings scene. the weights are 1 and 2 rather than a dp measurement, so the split holds
  on a panel of any width.

  **the name is in the toolbar rather than under the artwork.** it is the title of the screen, and a
  toolbar is where this app puts a screen's title; under the artwork it competed with the facts below
  it for which line was the heading, and both lost.

  the two lines that remain are facts about the dump and they are left aligned, because a column of
  values centred on itself has no edge to read down. the block hangs from the same line the first
  card starts on, so the two sides of the screen begin together.

  the list's padding, the scrollbar style and the fade are activity_settings.xml's, and the reasoning
  for each is written there.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back" />

    <!-- **the negative margin is against the toolbar, and it is the one every card screen in this
         app takes** — see activity_settings.xml, which explains it: a toolbar is 64dp with its title
         centred in it, so a strip below the baseline is empty, and the content below borrows a
         little of it rather than starting under the whole thing. without it this screen's cards sat
         6dp lower than the same cards everywhere else.

         **it is on the row rather than on either column**, so the artwork and the first card move
         together and stay on the one line they were just put on. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-6dp"
        android:orientation="horizontal">

        <!-- a constraint layout for one reason: **the artwork is square and only a ratio can say
             so.** a linear layout can give a view all of the width or all of the leftover height,
             and neither of those is a square — which is what the artwork is, and what its rounded
             corner needs it to be drawn as. -->
        <!-- **the artwork is inset from the screen by exactly what the cards are inset by**, so the
             three edges a person can see at once — the artwork's left, the artwork's right against
             the first card, and the last card's right against the screen — are one distance. that
             distance is not this padding: it is the list's own 10dp of scroll padding plus the 6dp
             margin every card in this app carries, 16dp between a card and whatever is beside it.

             **the two sides are therefore different numbers for the same gap.** on the left nothing
             else contributes, so the 16dp is spelled here. on the right the list contributes all of
             it already, so there is nothing left to add and this is zero — stated rather than
             omitted, because a padding that is absent reads as one nobody thought about.

             it is only right while those two numbers are what they are, and neither belongs to this
             file: they are the list in activity_settings.xml and the card itself. XML cannot hold
             the subtraction, which is why it is written out here. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="0dp"
            android:paddingTop="10dp">

            <!-- **as wide as the column allows, and exactly as tall.** `H,1:1` computes the height
                 from the width, so the box is a square whatever the panel is, and the artwork is
                 drawn inside it untouched: a square image in a square box fills it exactly, which is
                 what puts the rounded corner on the picture rather than on empty space beside it.

                 **fitCenter rather than a crop**, now that the box is the right shape. a crop would
                 also fill it, and would quietly take a slice off any dump whose icon is not square —
                 paying with somebody's artwork for a corner that is already correct.

                 the corner is the one every card in this app is cut with — see the shape style,
                 which says why it is the card's radius and not a tile's.

                 **it starts level with the first card, and the column's own top padding is what
                 makes that exact rather than close.** a card is inset from the top of its list by
                 that list's 4dp of padding and its own 6dp margin, so 10dp here starts the artwork
                 on the same line — the same trick as the horizontal gap above, and the same warning
                 applies: neither of those two numbers belongs to this file.

                 **the block hangs from that line rather than being centred in the column**, which it
                 was, and which put its top a couple of pixels above the card's by coincidence — a
                 centred block lands where its own height leaves it, and agreeing with a fixed inset
                 is not something it can be relied on to keep doing. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/titleId"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SharpEmu.Card" />

            <TextView
                android:id="@+id/titleId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icon" />

            <TextView
                android:id="@+id/version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleId" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sections"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_list_bottom" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
