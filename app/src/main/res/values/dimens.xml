<?xml version="1.0" encoding="utf-8"?>
<!--
  dimensions that more than one file has to agree on.

  a number only one layout uses stays in that layout, where it is read beside the view it moves.
-->
<resources>

    <!-- where a manager's empty line sits, drawn at the top of the list rather than in the middle of
         it. it lands about where the first card's own text would - see activity_manager.xml, which
         is where the arithmetic is. -->
    <dimen name="manager_empty_top">24dp</dimen>

    <!-- the label column on the per-game settings scene's fact table. it is here rather than in the
         layout because both orientations include that table and neither owns it, and it is a number
         about the longest label on that screen rather than about labels in general - see FactLabel,
         which is why the style carries no width of its own. -->
    <dimen name="game_fact_label">76dp</dimen>


</resources>
